GaussianSceneDataset.remove_outlier_ndevs=-1
GaussianSceneDataset.image_per_scene = None # Only used for train_dataset
GaussianSceneDataset.sample_ratio_test = None # Only used for train_dataset
GaussianSceneDataset.max_gs_num = 100000
GaussianSceneDataset.load_pose_src = 'nerfstudio'
GaussianSceneDataset.low_resolution = 256
GaussianSceneDataset.high_resolution = 1024
GaussianSceneDataset.input_ckpt_step = 14999

collate_fn = @gaussian_collate_fn
build_trainloader.batch_size = 1
build_trainloader.accumulate_step = 1
build_trainloader.num_workers = 4
build_trainloader.collate_fn = %collate_fn
train_dataset/GaussianSceneDataset.train_or_test = 'train'
train_dataset/GaussianSceneDataset.dataset_folder = 'data/shapenet/train'
train_dataset/GaussianSceneDataset.image_per_scene = 4
train_dataset/GaussianSceneDataset.sample_ratio_test = 0.7
train_dataset/GaussianSceneDataset.cache_steps = 1
train_dataset/GaussianSceneDataset.cache_num_scenes = 1  #no-cache
train_dataset/GaussianSceneDataset.split_across_gpus = True

build_testloader.batch_size = 1
build_testloader.num_workers = 0 #Must be 1, otherwise test set will be duplicated
build_testloader.collate_fn = %collate_fn
test_dataset/GaussianSceneDataset.train_or_test = 'test'
test_dataset/GaussianSceneDataset.dataset_folder = 'data/shapenet/test'
test_dataset/GaussianSceneDataset.cache_steps = 1
test_dataset/GaussianSceneDataset.cache_num_scenes = 1
test_dataset/GaussianSceneDataset.split_across_gpus = False
